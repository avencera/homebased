#!/bin/sh
set -eu
record="${FAKE_RECORD_DIR:?}"
mkdir -p "$record"
task="${HOMEBASED_TASK_ID:-unknown}"
# the agent's own pid, so tests can assert the agent group is gone rather than
# re-checking the worker pid they signalled
printf '%s\n' "$$" > "$record/agent-pid-$task.txt"
meta="$record/agent-meta-$task.txt"
{
  printf 'argv0=%s\n' "$0"
  printf 'argv=%s\n' "$*"
  printf 'PATH=%s\n' "${PATH:-}"
  printf 'HOME=%s\n' "${HOME:-}"
  printf 'HOMEBASED_TASK_ID=%s\n' "${HOMEBASED_TASK_ID:-}"
  printf 'HOMEBASED_HOME=%s\n' "${HOMEBASED_HOME:-}"
  printf 'CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=%s\n' "${CLAUDE_CODE_DISABLE_BACKGROUND_TASKS:-}"
} > "$meta"
cp "$meta" "$record/agent-meta.txt"
printf '%s\n' "$task" >> "$record/agent-runs.txt"

if [ -f "$record/ignore-term" ]; then
  trap '' TERM
fi

if [ -f "$record/no-stdin" ]; then
  : > "$record/stdin.txt"
else
  cat > "$record/stdin.txt" || true
fi
cp "$record/stdin.txt" "$record/stdin-$task.txt" || true

prev=
for arg in "$@"; do
  if [ "$prev" = "--prompt-file" ]; then
    cp "$arg" "$record/prompt-file.txt" || true
  fi
  prev=$arg
done

if [ -f "$record/stdout" ]; then
  cat "$record/stdout"
fi

sleep_for="${FAKE_SLEEP:-}"
if [ -f "$record/sleep" ]; then
  sleep_for=$(cat "$record/sleep")
fi
if [ -n "$sleep_for" ]; then
  sleep "$sleep_for"
fi

run_report() {
  file=$1
  if [ ! -f "$file" ]; then
    return 0
  fi
  outcome=$(head -n1 "$file")
  summary=$(tail -n +2 "$file")
  extra=
  if [ -f "$record/notify" ]; then
    extra=--notify
  fi
  homebased task report --outcome "$outcome" --summary "$summary" $extra
}

exit_code="${FAKE_EXIT:-0}"
if [ -f "$record/exit" ]; then
  exit_code=$(cat "$record/exit")
fi

# park once: the first line names the tasks to wait on and the rest is the
# notes. The first run that claims the control consumes it, so its
# continuation runs on the remaining controls
waiting="$record/waiting-$task"
if [ -f "$record/waiting" ] && mv "$record/waiting" "$waiting" 2>/dev/null; then
  targets=$(head -n1 "$waiting")
  set --
  for target in $targets; do
    set -- "$@" --on "$target"
  done
  tail -n +2 "$waiting" | homebased task report --outcome waiting "$@" \
    --summary "waiting on $targets" --notes-file -
  exit "$exit_code"
fi

if [ -n "${FAKE_REPORT:-}" ]; then
  extra=
  if [ -n "${FAKE_NOTIFY:-}" ]; then
    extra=--notify
  fi
  homebased task report --outcome "${FAKE_OUTCOME:-succeeded}" --summary "$FAKE_REPORT" $extra
fi

run_report "$record/report"
if [ -n "${FAKE_REPORT2:-}" ]; then
  homebased task report --outcome "${FAKE_OUTCOME2:-succeeded}" --summary "$FAKE_REPORT2"
fi
run_report "$record/report2"

exit "$exit_code"
